# API
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://localhost:8443
DATABASE_URL=postgresql://alevi:change-me@localhost:5432/alevi?schema=public
REDIS_URL=redis://localhost:6379
JWT_ISSUER=alevi-connect
JWT_AUDIENCE=alevi-mobile
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
FIELD_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Mesh
MESH_ENABLED=false
MESH_NODE_ID=bootstrap-1
MESH_ROLE=bootstrap
MESH_BIND_HOST=0.0.0.0
MESH_PORT=9443
MESH_ADVERTISE_HOST=127.0.0.1
MESH_BOOTSTRAP_PEERS=
MESH_CERT_DIR=./.alevi/mesh
MESH_JOIN_TOKEN_TTL_SECONDS=600
MESH_SHARED_CLUSTER_ID=replace-me

# Media / push
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alevi-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
FCM_PROJECT_ID=

# Client build values
CLIENT_API_BASE_URL=https://localhost:8443
ANDROID_APPLICATION_ID=com.alevi.connect
IOS_BUNDLE_ID=com.alevi.connect
WINDOWS_IDENTITY_NAME=
WINDOWS_PUBLISHER=
