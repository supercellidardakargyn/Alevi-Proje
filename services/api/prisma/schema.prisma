generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNMATCHED
}

enum SwipeDecision {
  LIKE
  PASS
}

enum ReportReason {
  HARASSMENT
  HATE
  SPAM
  SAFETY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

model User {
  id                         String                @id @default(uuid()) @db.Uuid
  email                      String                @unique @db.VarChar(320)
  passwordHash               String                @map("password_hash")
  displayName                String                @map("display_name") @db.VarChar(80)
  bio                        String?               @db.VarChar(2000)
  avatarUrl                  String?               @map("avatar_url") @db.VarChar(2048)
  sensitivePayloadCiphertext Bytes?               @map("sensitive_payload_ciphertext")
  sensitivePayloadVersion    Int?                  @map("sensitive_payload_version")
  consentVersion             String                @map("consent_version") @db.VarChar(32)
  emailVerified              Boolean               @default(false) @map("email_verified")
  googleSub                  String?               @unique @map("google_sub") @db.VarChar(255)
  city                       String?               @db.VarChar(120)
  latitude                   Float?
  longitude                  Float?
  interests                  String[]              @default([])
  inviteCode                 String                @unique @map("invite_code") @db.VarChar(12)
  invitedById                String?               @map("invited_by") @db.Uuid
  invitedBy                  User?                 @relation("invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees                   User[]                @relation("invites")
  role                       UserRole              @default(USER)
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")
  deletedAt                  DateTime?             @map("deleted_at")
  refreshTokens              RefreshToken[]
  blocksInitiated            Block[]               @relation("blocksInitiated")
  blocksReceived             Block[]               @relation("blocksReceived")
  reportsMade                Report[]              @relation("reportsMade")
  reportsAgainst             Report[]              @relation("reportsAgainst")
  swipesGiven                Swipe[]               @relation("swipesGiven")
  swipesReceived             Swipe[]               @relation("swipesReceived")
  matchesAsA                 Match[]               @relation("matchesAsA")
  matchesAsB                 Match[]               @relation("matchesAsB")
  conversationMemberships    ConversationMember[]
  sentMessages               Message[]
  communitiesOwned           Community[]           @relation("communityOwner")
  communityMemberships       CommunityMember[]
  communityPosts             CommunityPost[]
  emailVerifications         EmailVerification[]
  deviceTokens               DeviceToken[]
  eventsCreated              Event[]               @relation("eventsCreated")
  eventAttendances           EventAttendee[]
  supportTickets             SupportTicket[]

  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("blocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reportedId String?      @map("reported_id") @db.Uuid
  messageId  String?      @map("message_id") @db.Uuid
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  reporter   User         @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User?        @relation("reportsAgainst", fields: [reportedId], references: [id], onDelete: SetNull)
  message    Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId])
  @@map("reports")
}

model Swipe {
  id         String        @id @default(uuid()) @db.Uuid
  fromUserId String        @map("from_user_id") @db.Uuid
  toUserId   String        @map("to_user_id") @db.Uuid
  decision   SwipeDecision
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  fromUser   User          @relation("swipesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User          @relation("swipesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, decision])
  @@map("swipes")
}

model Match {
  id        String      @id @default(uuid()) @db.Uuid
  userAId   String      @map("user_a_id") @db.Uuid
  userBId   String      @map("user_b_id") @db.Uuid
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  userA     User        @relation("matchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User        @relation("matchesAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  @@map("matches")
}

model Community {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @map("owner_id") @db.Uuid
  name        String              @db.VarChar(120)
  description String?             @db.VarChar(2000)
  visibility  CommunityVisibility @default(PUBLIC)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  owner       User                @relation("communityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([visibility, createdAt])
  @@map("communities")
}

model CommunityMember {
  id          String        @id @default(uuid()) @db.Uuid
  communityId String        @map("community_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model CommunityPost {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@map("community_posts")
}

model Conversation {
  id        String                @id @default(uuid()) @db.Uuid
  title     String?               @db.VarChar(120)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String       @db.Text
  clientMessageId String?     @map("client_message_id") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at")
  editedAt       DateTime?     @map("edited_at")
  deletedAt      DateTime?     @map("deleted_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports        Report[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(80)
  targetType String  @map("target_type") @db.VarChar(80)
  targetId  String?  @map("target_id") @db.VarChar(128)
  reason    String?  @db.VarChar(2000)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model EdgeNode {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(80)
  meshHost   String    @map("mesh_host") @db.VarChar(255)
  meshPort   Int       @map("mesh_port")
  tokenHash  String    @map("token_hash") @db.VarChar(128)
  status     String    @default("pending") @db.VarChar(16)
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status, lastSeenAt])
  @@map("edge_nodes")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @default("verify") @db.VarChar(16)
  codeHash   String    @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("email_verifications")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String   @default("android") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Event {
  id          String          @id @default(uuid()) @db.Uuid
  creatorId   String          @map("creator_id") @db.Uuid
  title       String          @db.VarChar(120)
  description String?         @db.Text
  city        String?         @db.VarChar(120)
  startsAt    DateTime        @map("starts_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  creator     User            @relation("eventsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  attendees   EventAttendee[]

  @@index([startsAt])
  @@index([city, startsAt])
  @@map("events")
}

model EventAttendee {
  id       String   @id @default(uuid()) @db.Uuid
  eventId  String   @map("event_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_attendees")
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  subject   String   @db.VarChar(120)
  body      String   @db.Text
  status    String   @default("OPEN") @db.VarChar(16)
  reply     String?  @db.Text
  repliedAt DateTime? @map("replied_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("support_tickets")
}
