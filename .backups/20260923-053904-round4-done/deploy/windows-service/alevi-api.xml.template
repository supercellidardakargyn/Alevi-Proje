<?xml version="1.0" encoding="UTF-8"?>
<!-- WinSW template. install-service.ps1 replaces __...__ tokens. -->
<service>
  <id>__ALEVI_SERVICE_NAME__</id>
  <name>__ALEVI_DISPLAY_NAME__</name>
  <description>Alevi API server service</description>
  <executable>__ALEVI_NODE_PATH__</executable>
  <arguments>"__ALEVI_ENTRYPOINT__"</arguments>
  <workingdirectory>__ALEVI_RELEASE_DIR__</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="ALEVI_ENV_FILE" value="__ALEVI_ENV_FILE__" />
  <logpath>__ALEVI_LOG_DIR__</logpath>
  <log mode="roll-by-size" sizeThreshold="10485760" />
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>30 sec</stoptimeout>
  <resetfailure>1 day</resetfailure>
  <hidewindow>true</hidewindow>
</service>
